#!/usr/bin/env bash
set -euo pipefail

# Pi固有の更新対象。ツールの宣言とバージョン制約はmiseのグローバル設定に従う。
PI_TOOL="npm:@earendil-works/pi-coding-agent"
HERDR_TOOL="aqua:herdrdev/herdr"
PI_PACKAGES=(
  "npm:pi-web-access"
  "npm:@ogulcancelik/pi-session-recall"
  "git:github.com/u7chan/mypi@main"
)
# スキルの配布はPiから独立し、上流のdist.shが取得・検証・切替・linkを担う。
SKILLS_REPOSITORY="github.com/u7chan/agent-harness"
# 旧方式でPiへ登録していたsource。移行時にこの登録だけを解除する。
LEGACY_PI_SKILLS_SOURCE="git:${SKILLS_REPOSITORY}"
# 共有スキルの参照位置。親ディレクトリだけをここで用意し、中のlinkはdist.shが管理する。
SKILL_LINK_DIRS=("$HOME/.agents/skills" "$HOME/.claude/skills")

usage() {
  printf '%s\n' \
    'Usage: myupdate' \
    '' \
    'Update mise-managed Pi, Herdr, Claude Code, global JavaScript tools, Pi packages, and skills.' \
    'Run manually before starting work; no sudo or project-local updates.'
}

die() {
  printf 'myupdate: %s\n' "$*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi
(( $# == 0 )) || {
  usage >&2
  exit 2
}

# 呼び出し元のプロジェクト設定やmiseのバージョン指定を更新に持ち込まない。
cd "$HOME"
export MISE_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"
[[ -f $MISE_CONFIG_FILE ]] || die "run bootstrap first: missing $MISE_CONFIG_FILE"
for dependency in mise git jq; do
  command -v "$dependency" >/dev/null 2>&1 || die "$dependency is required"
done
mise_bin="$(command -v mise)"
# dist.shはGNUのmvとreadlinkを要するため、macOSではGNU用PATHを限定するランチャーで起動する。
launcher="$HOME/.local/bin/agent-harness-exec"
[[ -x $launcher ]] || die "run bootstrap first: missing $launcher"
# ランチャーと上流のdist.shは絶対パスを要するため、Piの更新を始める前に確認する。
skills_root="${AGENT_HARNESS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-harness}"
[[ $skills_root == /* ]] || die "AGENT_HARNESS_HOME and XDG_DATA_HOME must be absolute paths: $skills_root"

umask 077
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/macos-workstation"
[[ $state_dir == /* ]] || die "XDG_STATE_HOME must be an absolute path: $state_dir"
mkdir -p "$state_dir"
lock_dir="$state_dir/myupdate.lock"
mkdir "$lock_dir" 2>/dev/null || die "update lock exists: $lock_dir; check for another myupdate process before removing a stale lock"
bootstrap_dir=''
cleanup() {
  # set -e下でrmdirが失敗しても一時取得物を残さないよう、先に削除する。
  [[ -z $bootstrap_dir ]] || rm -rf "$bootstrap_dir" || true
  rmdir "$lock_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Piは壊れた設定を警告して既定値へ戻す場合があるため、書き込み前に停止する。
settings="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json"
if [[ -e $settings || -L $settings ]]; then
  [[ -f $settings ]] || die "Pi settings path is not a regular file: $settings"
  jq -e -s '
    length == 1 and (.[0] |
      type == "object"
      and (if has("packages") then
        .packages | type == "array" and all(.[];
          (type == "string" and length > 0)
          or (type == "object" and (.source | type == "string" and length > 0))
        )
      else true end)
    )
  ' "$settings" >/dev/null || die "invalid Pi settings; keeping existing data: $settings"
fi

# lsは版解決に失敗したツールを省略するため、版解決しない設定メタデータを使う。
config_entries="$("$mise_bin" config ls --json | jq -sc '
  if length == 1 and (.[0] | type == "array" and all(.[];
    type == "object" and (.path | type == "string")
    and (.tools | type == "array" and all(.[]; type == "string"))
  )) then .[0][] else error("invalid mise config inventory") end
')"

# 他の設定は取り込まず、シンボリックリンクや物理パス表記の違いは同一ファイルとして扱う。
global_tools=''
while IFS= read -r entry; do
  [[ -n $entry ]] || continue
  config_path="$(jq -r '.path' <<< "$entry")"
  [[ $config_path -ef $MISE_CONFIG_FILE ]] || continue
  [[ -z $global_tools ]] || die "duplicate global mise configuration in declaration inventory"
  global_tools="$(jq -c '.tools' <<< "$entry")"
done <<< "$config_entries"
[[ -n $global_tools ]] || die "global mise configuration not found in declaration inventory"

# npm製CLIは宣言だけで対象にする。Piは下で一度だけ更新する。
extra_tools="$(jq -r --arg pi "$PI_TOOL" '
  unique[]
  | select(. != $pi)
  | select(. == "bun" or . == "pnpm" or . == "aqua:pnpm/pnpm" or . == "aqua:anthropics/claude-code" or startswith("npm:"))
' <<< "$global_tools")"

# 実行中のPiが参照している旧インストールは削除しない。
printf '==> updating Pi through mise\n'
"$mise_bin" upgrade --no-prune "$PI_TOOL"

# 稼働中のHerdrサーバーとペインを停止せず、旧バイナリも保持する。
printf '==> updating Herdr through mise\n'
"$mise_bin" upgrade --no-prune "$HERDR_TOOL"

# 空の一覧で引数なしのupgradeを呼ばず、プロジェクト依存や他のランタイムを更新しない。
while IFS= read -r tool; do
  [[ -n $tool ]] || continue
  printf '==> updating global tool %s through mise\n' "$tool"
  "$mise_bin" upgrade --no-prune "$tool"
done <<< "$extra_tools"

run_pi() {
  # upgrade後に再解決し、シェルのPATHに残った古いPiを使用しない。
  "$mise_bin" exec -- pi "$@"
}

# installは既存登録・フィルターを保持して更新でき、初回導入にも使える。
for source in "${PI_PACKAGES[@]}"; do
  printf '==> ensuring Pi package %s\n' "$source"
  run_pi install "$source" --no-approve
done

# スキル配布の更新。Pi・Claude Codeなどのharness CLIは呼ばない。
skills_dist="$skills_root/current/scripts/skill-distribution/dist.sh"
link_args=()
for dir in "${SKILL_LINK_DIRS[@]}"; do
  link_args+=(--link-dir "$dir")
done

# 配布先がない初回だけ、上流のmainを一時的に取得してその中のdist.shで配布先を作る。
# 以後は配布先のdist.shを使うため、固定SHAを持たず、新しい版を古い版へ戻さない。
bootstrap_agent_skills() {
  bootstrap_dir="$(mktemp -d "$state_dir/agent-skills-bootstrap.XXXXXX")"
  # dist.shはmainだけを配る。ここで取得するのはそのdist.shを得るためなので、ブランチはmain固定にする。
  GIT_TERMINAL_PROMPT=0 git clone --quiet --depth 1 --branch main \
    "https://${SKILLS_REPOSITORY}.git" "$bootstrap_dir/repo"
  "$launcher" "$bootstrap_dir/repo/scripts/skill-distribution/dist.sh" update "${link_args[@]}"
  rm -rf "$bootstrap_dir"
  bootstrap_dir=''
}

# 失敗時の旧版維持・mainへの到達確認・記録はdist.shが担うため、ここでは再実装せず結果を伝播する。
update_agent_skills() {
  mkdir -p "${SKILL_LINK_DIRS[@]}"
  if [[ -x $skills_dist ]]; then
    printf '==> updating agent skills (%s)\n' "$SKILLS_REPOSITORY"
    "$launcher" "$skills_dist" update "${link_args[@]}"
  else
    if [[ -e $skills_root/current || -L $skills_root/current ]]; then
      printf '==> repairing agent skills: %s has no usable dist.sh\n' "$skills_root/current"
    fi
    printf '==> installing agent skills (%s)\n' "$SKILLS_REPOSITORY"
    bootstrap_agent_skills
  fi
  printf '==> agent skills status\n'
  "$launcher" "$skills_dist" status "${link_args[@]}"
}

legacy_pi_skills_sources() {
  [[ -f $settings ]] || return 0
  jq -r --arg base "$LEGACY_PI_SKILLS_SOURCE" '
    (.packages // [])[]
    | if type == "string" then . else .source end
    | select(. == $base or startswith($base + "@"))
  ' "$settings"
}

# 同名スキルの重複を避けるため、新しい配布が検証済みになった後に旧登録だけを解除する。
# 他のパッケージ・認証・履歴・設定には触れず、解除した登録内容を表示して復元できるようにする。
remove_legacy_pi_skills() {
  local sources source status
  sources="$(legacy_pi_skills_sources)"
  while IFS= read -r source; do
    [[ -n $source ]] || continue
    printf '==> removing legacy Pi registration %s\n' "$source"
    jq -c --arg source "$source" '
      (.packages // [])[] | select((if type == "string" then . else .source end) == $source)
    ' "$settings"
    status=0
    run_pi remove "$source" --no-approve || status=$?
    if (( status != 0 )); then
      # 新しい配布は有効なため、旧登録が残るとPiで同名スキルが二重に見える。
      printf 'myupdate: could not remove the legacy Pi registration; run before starting Pi:\n  pi remove %q --no-approve\n' "$source" >&2
      exit "$status"
    fi
  done <<< "$sources"
  [[ -z "$(legacy_pi_skills_sources)" ]] || die "legacy Pi registration is still present in $settings; inspect it with: pi list --no-approve"
}

update_agent_skills
remove_legacy_pi_skills

printf '==> Pi version and user packages\n'
run_pi --version
run_pi list --no-approve
printf '==> Herdr version\n'
"$mise_bin" exec -- herdr --version
printf '%s\n' \
  'myupdate: all updates completed successfully' \
  'Start Pi to begin work. Exit all Pi sessions before the next update.' \
  'Restart running Claude Code and other agent sessions to load the current skill list.'
